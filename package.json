{
  "name": "formcheck",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "On-device squat depth checker (v0 prototype)",
  "scripts": {
    "postinstall": "node scripts/fetch-assets.mjs",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "dev": "vite --host",
    "build": "tsc --noEmit && tsc --noEmit -p tests && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "fixtures": "node scripts/make-fixtures.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.0",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
