{
  "name": "formcheck",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "On-device squat depth checker (v0 prototype)",
  "scripts": {
    "postinstall": "node scripts/fetch-assets.mjs",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "dev": "vite --host",
    "build": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p src/offline && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "fixtures": "node scripts/make-fixtures.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p src/offline",
    "demo:sheets": "node tools/demo-sheets/sheets.cjs",
    "demo:contact": "DEMO_TOOL=tools/demo-sheets/contact.tool.ts vitest run --config tools/demo-sheets/vitest.config.ts --silent=false",
    "offline:check": "node tools/offline-check/check.cjs",
    "landing:check": "node tools/landing-check/check.cjs",
    "landing:screens": "node tools/landing-screens/shoot.cjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@mediapipe/tasks-vision": "1.2.0",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
